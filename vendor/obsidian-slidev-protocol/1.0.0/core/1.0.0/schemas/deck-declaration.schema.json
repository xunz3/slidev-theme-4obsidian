{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://obsidian-slidev.dev/protocol/core/1.0.0/schemas/deck-declaration.schema.json",
  "title": "Obsidian Slidev generated core declaration",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "publication"],
  "properties": {
    "id": {
      "const": "obsidian-slidev/core"
    },
    "version": {
      "$ref": "#/$defs/stableSemVer"
    },
    "publication": {
      "$ref": "#/$defs/publication"
    }
  },
  "$defs": {
    "stableSemVer": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "manifestSha256"],
      "properties": {
        "version": {
          "$ref": "#/$defs/stableSemVer"
        },
        "manifestSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
