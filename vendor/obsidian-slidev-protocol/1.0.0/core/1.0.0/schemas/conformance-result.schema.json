{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://obsidian-slidev.dev/protocol/core/1.0.0/schemas/conformance-result.schema.json",
  "title": "Obsidian Slidev formal conformance result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "scope",
    "reasonCode",
    "publication",
    "compatibility",
    "fixtureResults",
    "implementationEvidence"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "status": {
      "enum": ["conforming", "unverified", "incompatible"]
    },
    "scope": {
      "enum": ["core", "profile", "core+profile"]
    },
    "reasonCode": {
      "type": "string",
      "minLength": 1
    },
    "publication": {
      "$ref": "#/$defs/hashedVersion"
    },
    "deckDeclaration": {
      "type": ["object", "null"]
    },
    "supportDeclaration": {
      "type": ["object", "null"]
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "scope", "reasonCode"],
      "properties": {
        "status": {
          "enum": ["compatible", "unverified", "incompatible"]
        },
        "scope": {
          "enum": ["core", "core+profile"]
        },
        "reasonCode": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "fixtureResults": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "inputSha256", "expectedSha256"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": ["pass", "fail"]
          },
          "inputSha256": {
            "$ref": "#/$defs/sha256"
          },
          "expectedSha256": {
            "$ref": "#/$defs/sha256"
          },
          "actualSha256": {
            "$ref": "#/$defs/sha256"
          },
          "failureCode": {
            "type": "string"
          }
        }
      }
    },
    "implementationEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name",
        "version",
        "revision",
        "sourceState",
        "root",
        "commands"
      ],
      "properties": {
        "kind": {
          "enum": ["plugin", "theme"]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "sourceState": {
          "enum": ["clean", "dirty"]
        },
        "root": {
          "type": "string",
          "minLength": 1
        },
        "packageHash": {
          "$ref": "#/$defs/sha256"
        },
        "protocolLockHash": {
          "$ref": "#/$defs/sha256"
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "prePostSnapshots": {
          "type": "object"
        }
      }
    }
  },
  "$defs": {
    "stableSemVer": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "hashedVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "manifestSha256"],
      "properties": {
        "version": {
          "$ref": "#/$defs/stableSemVer"
        },
        "manifestSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
