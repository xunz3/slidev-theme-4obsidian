{
  "schemaVersion": 1,
  "coordinate": {
    "id": "obsidian-slidev/presentation",
    "version": "1.0.0"
  },
  "selection": {
    "explicit": true,
    "themeIndependent": true,
    "preservedExactly": true
  },
  "components": [
    "Callout",
    "Figure",
    "Authors",
    "Steps",
    "Timeline",
    "Tag",
    "Badge",
    "Kbd"
  ],
  "componentFacts": {
    "unknownComponentPreserved": true,
    "selfClosingAndMultilineTags": true,
    "bindingsAndQuotesPreserved": true,
    "defaultAndNamedSlotsPreserved": true,
    "nestingAndOrderPreserved": true,
    "slotProseTransforms": true,
    "tagPropertiesProtected": true,
    "inlineAndFencedExamplesLiteral": true
  },
  "layouts": [
    "end",
    "figure",
    "image-left",
    "image-right",
    "code"
  ],
  "rootMetadata": {
    "authors": 2,
    "authorFields": [
      "name",
      "institution",
      "email"
    ],
    "density": "normal",
    "chrome": "auto",
    "header": false,
    "footerAuthors": true,
    "pageNumber": true,
    "accent": "#345f8f"
  },
  "slideMetadata": {
    "accentIsolation": true,
    "imageBackgroundSizePreserved": true,
    "closingInputsPreserved": true,
    "presentationOverridesPreserved": true
  },
  "semanticFacts": {
    "tasksPreserved": true,
    "balancedHighlightsConverted": 4,
    "protectedHighlightsLiteral": 2,
    "calloutCoreEquivalent": true,
    "figureCoreEquivalent": true
  },
  "forbiddenInference": [
    "theme",
    "package",
    "component-scan",
    "layout-scan",
    "configuration",
    "path"
  ],
  "preservation": {
    "sourceBytesUnchanged": true,
    "sourceMtimeUnchanged": true,
    "normalizedGeneratedSemanticsInvariantWhenOnlyThemeChanges": true
  }
}
