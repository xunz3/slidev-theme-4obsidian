{
  "schemaVersion": 1,
  "id": "obsidian-slidev/presentation",
  "version": "1.0.0",
  "coreRequirement": {
    "id": "obsidian-slidev/core",
    "ranges": [
      {
        "minInclusive": "1.0.0",
        "maxExclusive": "1.1.0"
      }
    ]
  },
  "components": [
    {
      "name": "Callout",
      "properties": ["type", "title"],
      "slots": ["default"],
      "coreEquivalent": "callout"
    },
    {
      "name": "Figure",
      "properties": ["src", "alt", "caption", "fit"],
      "slots": ["default"],
      "coreEquivalent": "image-figure"
    },
    {
      "name": "Authors",
      "properties": ["variant"],
      "slots": ["default"],
      "rootMetadata": ["authors", "author"]
    },
    {
      "name": "Steps",
      "properties": [],
      "slots": ["default"]
    },
    {
      "name": "Timeline",
      "properties": [],
      "slots": ["default"]
    },
    {
      "name": "Tag",
      "properties": [],
      "slots": ["default"]
    },
    {
      "name": "Badge",
      "properties": ["tone", "marker"],
      "slots": ["default"]
    },
    {
      "name": "Kbd",
      "properties": ["keys"],
      "slots": ["default"]
    }
  ],
  "layouts": [
    {
      "name": "end",
      "inputs": [
        "contact",
        "showAuthors",
        "logo",
        "logoAlt",
        "chrome",
        "title",
        "subtitle"
      ]
    },
    {
      "name": "figure",
      "inputs": ["chrome", "title", "subtitle"]
    },
    {
      "name": "image-left",
      "inputs": [
        "image",
        "imageAlt",
        "caption",
        "backgroundSize",
        "class",
        "chrome",
        "title",
        "subtitle"
      ]
    },
    {
      "name": "image-right",
      "inputs": [
        "image",
        "imageAlt",
        "caption",
        "backgroundSize",
        "class",
        "chrome",
        "title",
        "subtitle"
      ]
    },
    {
      "name": "code",
      "inputs": ["chrome", "title", "subtitle"]
    }
  ],
  "rootMetadata": [
    "title",
    "subtitle",
    "footer",
    "authors",
    "author",
    "themeConfig.presentation"
  ],
  "slideMetadata": [
    "layout",
    "layoutClass",
    "class",
    "background",
    "transition",
    "title",
    "subtitle",
    "presentationPreset",
    "presentationDensity",
    "presentationChrome",
    "chrome",
    "presentationHeader",
    "header",
    "footerAuthors",
    "pageNumber",
    "footer",
    "accent",
    "contact",
    "showAuthors",
    "logo",
    "logoAlt",
    "image",
    "imageAlt",
    "caption",
    "backgroundSize",
    "author",
    "source"
  ],
  "commonConfiguration": {
    "density": {
      "values": ["compact", "normal", "relaxed"],
      "default": "normal"
    },
    "chrome": {
      "values": ["auto", "on", "off"],
      "default": "auto"
    },
    "header": {
      "type": "boolean",
      "default": false
    },
    "footerAuthors": {
      "type": "boolean",
      "default": true
    },
    "pageNumber": {
      "type": "boolean",
      "default": true
    },
    "accent": {
      "type": "css-color"
    },
    "preset": {
      "type": "implementation-defined-string"
    }
  },
  "preservation": {
    "componentNameAndCase": true,
    "tagAndPropertyTokens": true,
    "slotBoundaries": true,
    "nestingAndOrder": true,
    "transformableSlotProse": true,
    "protectedCodeCommentsAndTags": true,
    "themeIndependent": true
  }
}
